{
  "id": "bryn_watch_uneasy",
  "start": "hub",
  "requires": ["world:threat_near"],
  "bindings": [{ "kind": "actor", "target": "warden_bryn", "priority": 7 }],
  "nodes": [
    {
      "id": "hub",
      "text": "Smoke past the hedgerows that isn't ours. I count fires at dusk — last night there was one too many.",
      "choices": [
        {
          "text": "Where are they camped?",
          "next": "mark",
          "forbids": ["world:bounty_open"]
        },
        {
          "text": "Say the bearing again.",
          "next": "remark",
          "requires": ["world:bounty_open"]
        },
        { "text": "How bad is it?", "next": "count" },
        { "text": "Not my errand today.", "next": "dismiss" }
      ]
    },
    {
      "id": "mark",
      "text": "Marked. Go before they dig in. Break it, come home, report.",
      "hooks": [{ "kind": "bounty" }]
    },
    {
      "id": "remark",
      "text": "Same smoke as before. Your chart holds it. Go.",
      "hooks": [{ "kind": "bounty" }]
    },
    {
      "id": "count",
      "text": "Wolves take a lamb, that's weather. A camp takes the road, and the road is how bread gets here. Bad enough.",
      "next": "hub"
    },
    {
      "id": "dismiss",
      "text": "Then send me someone who will."
    }
  ]
}
