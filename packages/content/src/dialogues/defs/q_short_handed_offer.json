  "bindings": [{ "kind": "actor", "target": "marshal_kestrel", "priority": 6 }],
  "nodes": [
    {
      "id": "hub",
      "text": "Roll's short. Wolves between the lamps again. Six put down is a shift I don't have a warden for. You're not my first choice. You're the one standing here.",
