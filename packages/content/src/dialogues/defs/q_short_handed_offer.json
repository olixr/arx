      "choices": [
        { "text": "I'll walk the shift.", "next": "sworn" },
        { "text": "Find another.", "next": "declined" }
      ]
    },
    {
      "id": "sworn",
      "text": "Lamp to lamp. Don't be clever about it.",
      "hooks": [{ "kind": "quest_accept", "quest": "short_handed" }]
    },
    {
      "id": "declined",
      "text": "There isn't another. That was the point."
    }
  ]
