        {
          "kind": "quest_offer",
          "quest": "the_free_furrows"
        }
      ],
      "choices": [
        {
          "text": "Lend me a row.",
          "next": "sworn"
        },
        {
          "text": "Dirt and I disagree.",
          "next": "declined"
        }
      ],
      "voice": "q_the_free_furrows_offer__hub"
    },
    {
      "id": "sworn",
      "text": "Seeds at Jorel's stall, water in the barrel, and talk to the soil if it helps. It helps me. Don't tell Jorel.",
      "hooks": [
        {
          "kind": "quest_accept",
          "quest": "the_free_furrows"
        }
      ],
      "voice": "q_the_free_furrows_offer__sworn"
    },
    {
      "id": "declined",
      "text": "The dirt always wins the disagreement, love. It just waits.",
