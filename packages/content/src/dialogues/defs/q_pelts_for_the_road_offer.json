      "choices": [
        { "text": "Six furs. Done.", "next": "sworn" },
        { "text": "Not for wolf pay.", "next": "declined" }
      ]
    },
    {
      "id": "sworn",
      "voice": "q_pelts_for_the_road_offer__sworn",
      "text": "Aim before the second one commits. Off you go.",
      "hooks": [{ "kind": "quest_accept", "quest": "pelts_for_the_road" }]
    },
    {
      "id": "declined",
      "voice": "q_pelts_for_the_road_offer__declined",
      "text": "Fair enough."
    }
  ]
}
