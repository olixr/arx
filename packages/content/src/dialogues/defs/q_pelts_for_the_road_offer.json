  "requires": ["quest:pelts_for_the_road:available"],
  "bindings": [{ "kind": "actor", "target": "outfitter_hask", "priority": 5 }],
  "nodes": [
    {
      "id": "hub",
      "voice": "q_pelts_for_the_road_offer__hub",
      "text": "Winter cloaks want lining and I won't sell thin. Six wolf furs, clean ones. Wolves run the tree lines, and they don't come alone. Hear that part twice. Work you want?",
