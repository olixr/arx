      "choices": [
        { "text": "Six trout, coming up.", "next": "sworn" },
        { "text": "No time to fish today.", "next": "declined" }
      ]
    },
    {
      "id": "sworn",
      "voice": "q_the_pot_never_rests_offer__sworn",
      "text": "Take bread for the bank. Fishing's hungry work, whatever it looks like.",
      "hooks": [{ "kind": "quest_accept", "quest": "the_pot_never_rests" }]
    },
    {
      "id": "declined",
      "voice": "q_the_pot_never_rests_offer__declined",
      "text": "Then come by for a bowl anyway."
    }
