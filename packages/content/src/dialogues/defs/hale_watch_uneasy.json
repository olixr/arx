{
  "id": "hale_watch_uneasy",
  "start": "hub",
  "requires": ["world:threat_near"],
  "bindings": [{ "kind": "actor", "target": "waykeeper_hale", "priority": 7 }],
  "nodes": [
    {
      "id": "hub",
      "voice": "hale_watch_uneasy__hub",
      "text": "Something's set up shop on my fourteen miles, uninvited. I keep a ledger of who works this road. They're not in it.",
      "choices": [
        {
          "text": "Where are they camped?",
          "next": "mark",
          "forbids": ["world:bounty_open"]
        },
        {
          "text": "Say it again. Where?",
          "next": "remark",
          "requires": ["world:bounty_open"]
        },
        { "text": "Who are they?", "next": "who" },
        { "text": "I'll pass.", "next": "pass" }
      ]
    },
    {
      "id": "mark",
      "voice": "hale_watch_uneasy__mark",
      "text": "There's your mark. The post can't leave the lamp, so the errand's yours.",
      "hooks": [{ "kind": "bounty" }]
    },
    {
      "id": "remark",
      "voice": "hale_watch_uneasy__remark",
      "text": "The mark's on your chart. It hasn't moved.",
      "hooks": [{ "kind": "bounty" }]
    },
    {
      "id": "who",
      "voice": "hale_watch_uneasy__who",
      "text": "Fires say brigand, tracks say more than four. Past that I'd be guessing.",
      "next": "hub"
    },
    {
      "id": "pass",
      "voice": "hale_watch_uneasy__pass",
      "text": "Then walk the middle of the road and don't stop to look."
    }
  ]
}
