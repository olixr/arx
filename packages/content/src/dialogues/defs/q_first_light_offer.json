      "id": "hub",
      "voice": "q_first_light_offer__hub",
      "text": "Before the road can ask after you, the yard should. Go meet the three who keep it: *Halla* at the drill ground, her fletcher *Rill*, and *Old Varn* at his circle. Each teaches for the asking. Will you go?",
      "hooks": [
        {
          "kind": "quest_offer",
          "quest": "first_light"
        }
      ],
      "choices": [
        {
          "text": "I'll go meet them.",
          "next": "sworn"
        },
        {
          "text": "Not yet.",
          "next": "declined"
        }
      ]
    },
    {
      "id": "sworn",
      "voice": "q_first_light_offer__sworn",
      "text": "Good. Start with Halla. Shoulders back, child. She'll say it if I don't.",
      "hooks": [
        {
          "kind": "quest_accept",
          "quest": "first_light"
        }
      ]
    },
    {
      "id": "declined",
      "voice": "q_first_light_offer__declined",
      "text": "Then warm yourself here a while longer. The yard keeps."
    }
  ]
