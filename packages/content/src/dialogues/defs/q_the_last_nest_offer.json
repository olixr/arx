        {
          "kind": "quest_offer",
          "quest": "the_last_nest"
        }
      ],
      "choices": [
        {
          "text": "I'll clear it.",
          "next": "sworn"
        },
        {
          "text": "Not yet.",
          "next": "declined"
        }
      ]
    },
    {
      "id": "sworn",
      "text": "Then finish it. Come back when the ruin goes quiet.",
      "hooks": [
        {
          "kind": "quest_accept",
          "quest": "the_last_nest"
        }
      ]
    },
    {
      "id": "declined",
      "text": "The nest won't wait politely. Say when."
    }
