{
  "id": "alder_copse",
  "start": "hub",
  "bindings": [{ "kind": "actor", "target": "forester_alder" }],
  "nodes": [
    {
      "id": "hub",
      "voice": "alder_copse__hub",
      "text": "Morning. Or thereabouts. Need something?",
      "choices": [
        { "text": "Which trees can I take?", "next": "marked" },
        { "text": "Tell me about the big oak.", "next": "oak" },
        { "text": "Just walking the copse.", "next": "pass" },
        {
          "text": "The stand at the fork, then.",
          "next": "reoffer_root",
          "requires": ["grey_root_declined", "quest:the_grey_root:available"]
        }
      ]
    },
    {
      "id": "marked",
      "voice": "alder_copse__marked",
      "text": "Blaze cut low on the trunk means take it. No blaze means it's still working. The stand knows what it can spare better than either of us, and I just write down its answer.",
      "next": "hub"
    },
    {
      "id": "oak",
      "voice": "alder_copse__oak",
      "text": "Went in the year I was born, by the hut there. My mother planted it the week she couldn't lift a spade anymore, out of spite at the idea. We're neither of us done growing.",
      "next": "hub"
    },
    {
      "id": "pass",
      "voice": "alder_copse__pass",
      "text": "Look up before you swing."
    },
    {
      "id": "reoffer_root",
      "voice": "alder_copse__reoffer_root",
      "text": "The wood inside the thread, twelve of cord and two of yew, here. The offer stands where it stood.",
      "hooks": [{ "kind": "quest_offer", "quest": "the_grey_root" }],
      "choices": [
        { "text": "I will.", "next": "resworn_root", "set": ["grey_root_sworn"] },
        { "text": "Still no." }
      ]
    },
    {
      "id": "resworn_root",
      "voice": "alder_copse__resworn_root",
      "text": "Speak to Bodil at the cut. Look up before you swing.",
      "hooks": [{ "kind": "quest_accept", "quest": "the_grey_root" }]
    }
  ]
}
