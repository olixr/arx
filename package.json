{
  "name": "devcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @devcraft/server",
    "dev:client": "npm run dev -w @devcraft/client",
    "build": "npm run build -w @devcraft/client",
    "start": "npm run start -w @devcraft/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b packages/shared packages/content packages/server packages/client packages/tools"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
