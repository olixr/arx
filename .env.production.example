# Arx production environment — copy to <repo>/.env on the server.
# scripts/arx-run.sh and scripts/arxctl.sh both load this file.

NODE_ENV=production

# Game server bind — loopback only; nginx proxies wss://arx.gg/ws here.
PORT=8790
HOST=127.0.0.1

MOTD=Welcome to Arx!
WORLD_SEED=1337

# The world lives in Postgres. Create the database and user in Forge
# (server → Database) and put the real credentials here — they stay in
# discrete vars, never inside a connection URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arx
DB_USERNAME=forge
DB_PASSWORD=CHANGE_ME

# Authored disk content (map overrides in data/maps, the POI prefab
# library in data/prefabs) ships INSIDE each release via git and is
# read from the release's own data/ directory by default — no DATA_DIR
# needed. All live world state is in Postgres.

# These already default OFF when NODE_ENV=production; pinned here so
# the intent is explicit. DEV_COMMANDS gates /give-style chat commands
# AND the /dev studio API; ALLOW_GUEST gates accountless joins.
DEV_COMMANDS=0
ALLOW_GUEST=0

# THE INVITE GATE. REQUIRE_INVITE already defaults ON in production
# (pinned here so the intent is explicit): creating an account demands
# a working invite code, and everyone else is politely turned away.
# INVITE_CODE is seeded into the invite_codes ledger at every boot
# (unlimited uses) — rotate it by changing this value and restarting;
# the old code stays in the ledger, disable it with:
#   UPDATE invite_codes SET disabled = 1 WHERE code = 'OLD-CODE';
REQUIRE_INVITE=1
INVITE_CODE=CHANGE_ME_LONG_RANDOM

# Overload fuse: hard cap on simultaneous WebSocket connections.
# Per-IP connection and auth-attempt budgets are built in and always on.
MAX_CONNECTIONS=300

# Supervisor program name for scripts/arxctl.sh.
# Using deploy/arx-supervisor.conf: leave as "arx".
# Using a Forge Daemon instead: set to that daemon, e.g. "daemon-123456:*"
ARX_PROGRAM=arx
